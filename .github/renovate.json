{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    "helpers:pinGitHubActionDigests",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
    "customManagers:makefileVersions"
  ],
  "dependencyDashboard": true,
  "labels": ["renovate"],
  "packageRules": [
    {
      "groupName": "Go and Alpine versions",
      "matchDatasources": ["golang-version", "docker"],
      "matchPackageNames": ["go", "golang", "alpine"],
      "group": {
        "commitMessageTopic": "{{#if (includes (lookupArray upgrades 'depName') 'alpine')}}{{#if (or (includes (lookupArray upgrades 'depName') 'go') (includes (lookupArray upgrades 'depName') 'golang'))}}Go and Alpine versions{{else}}Alpine version{{/if}}{{else}}Go version{{/if}}"
      }
    },
    {
      "matchDatasources": ["golang-version"],
      "matchPackageNames": ["go"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "7 days",
      "allowedVersions": "/^\\d+\\.\\d+\\.[1-9]\\d*$/",
      "prPriority": 10
    },
    {
      "description": "Treat the Dockerfile Go argument as an exact version, not a module compatibility range",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["golang-version"],
      "matchPackageNames": ["go"],
      "rangeStrategy": "replace"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "pinDigests": true,
      "prPriority": 10
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "prPriority": 10
    },
    {
      "description": "Update Go and Alpine versions through their shared build arguments",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "enabled": false
    },
    {
      "groupName": "Go dependencies",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["!go"],
      "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"]
    }
  ]
}
